# ==============================================================================
# ZMIE — Production Git Ignore Policy
# Protects Secrets, Private Keys, Virtual Environments, and Local Caches
# ==============================================================================

# --- Secrets & Environment Configurations (CRITICAL) ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.p12

# --- Python Virtual Environments ---
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# --- Byte-compiled / optimized / DLL files ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# --- Testing, Coverage & Type Checking ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Node / Frontend Artifacts ---
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Operating System & Editor Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# --- Local Databases & Transient Storage ---
*.sqlite3
*.db
postgres_data/
neo4j_data/
redis_data/
minio_data/
*.log
