{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ZMIE Drug-Herb-Gene Triad Safety Contract",
  "type": "object",
  "required": ["overall_status", "critical_alerts_count", "alerts"],
  "properties": {
    "overall_status": { "type": "string" },
    "critical_alerts_count": { "type": "integer" },
    "major_alerts_count": { "type": "integer" },
    "alerts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["alert_id", "severity", "interaction_type", "biochemical_mechanism"],
        "properties": {
          "alert_id": { "type": "string" },
          "severity": { "type": "string" },
          "interaction_type": { "type": "string" },
          "participating_agents": { "type": "array", "items": { "type": "string" } },
          "biochemical_mechanism": { "type": "string" },
          "clinical_risk": { "type": "string" },
          "actionable_directive": { "type": "string" },
          "fda_boxed_warning_reference": { "type": ["string", "null"] }
        }
      }
    }
  }
}
