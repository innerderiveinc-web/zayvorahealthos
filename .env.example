# ==============================================================================
# ZMIE — Environment Template (.env.example)
# Copy to .env and configure secrets
# ==============================================================================
ZMIE_ENV=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

JWT_SECRET=replace_with_a_secure_random_key_min_32_characters
AUDIT_HMAC_SECRET=replace_with_a_secure_audit_secret

DATABASE_URL=postgresql://zmie_admin:zmie_secure_password@localhost:5432/zmie_knowledge_db
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=zmie_graph_password

REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000

# Canonical Registries
OPENALEX_MAILTO=research@yourdomain.org
NCBI_API_KEY=optional_ncbi_key
CROSSREF_MAILTO=research@yourdomain.org

# Optional Multi-Model LLM Gateway (Fail-Closed Grounded Routing)
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=biomistral-7b
